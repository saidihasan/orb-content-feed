/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://orb-content-feed.saidihasan.workers.dev; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
